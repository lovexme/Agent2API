[Unit]
Description=AAM AI Account Manager Panel
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/aam-panel
EnvironmentFile=/opt/aam-panel/.env
ExecStart=/opt/aam-panel/venv/bin/python -m uvicorn backend.main:app --host 0.0.0.0 --port 8710
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target